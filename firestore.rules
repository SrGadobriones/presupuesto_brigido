rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function esDueno(uid) { return request.auth != null && request.auth.uid == uid; }
  match /usuarios/{uid}/listas/{lista} { allow read, write: if esDueno(uid);
    match /productos/{producto} { allow read, write: if esDueno(uid);
      match /fotos/{foto} { allow read, delete: if esDueno(uid); allow create, update: if esDueno(uid) && request.resource.data.bytes is bytes && request.resource.data.bytes.size() <= 900000; }
    }
  }
}}
