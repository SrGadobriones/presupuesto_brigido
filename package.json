{
  "name": "presupuesto_brigido",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --watch astro.config.mjs --watch package.json --exec \"astro dev\"",
    "build": "astro build",
    "preview": "astro preview",
    "android:sync": "astro build && cap sync android",
    "android:apk": "astro build && cap sync android && cd android && gradlew.bat assembleDebug",
    "test": "vitest run",
    "test:watch": "nodemon --watch src --watch tests --ext ts,tsx --exec \"vitest run\""
  },
  "type": "module",
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.5",
    "firebase": "^12.6.0",
    "preact": "^11.1.1",
    "sql.js": "^1.15.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/sql.js": "^1.4.11",
    "fake-indexeddb": "^6.2.7",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
